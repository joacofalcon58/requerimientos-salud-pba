table GBA_Rendimientos
	lineageTag: 47d04211-0831-4081-9d7d-a99767b92059

	measure 'Total Consultas Médicas' = SUM(GBA_Rendimientos[consultas_medicas])
		formatString: #,##0
		displayFolder: 01. Demanda
		lineageTag: 85226f16-dadb-4e2c-85ad-104f87f2ed1b

	measure 'Total Consultas Odontológicas' = SUM(GBA_Rendimientos[consultas_odontologicas])
		formatString: #,##0
		displayFolder: 01. Demanda
		lineageTag: 567db131-23b9-4072-b1de-ae4899494d9d

	measure 'Total Consultas Paramédicas' = SUM(GBA_Rendimientos[consultas_paramedicas])
		formatString: #,##0
		displayFolder: 01. Demanda
		lineageTag: 6a80cc30-2599-47f1-bec9-90e26eedcfa5

	measure 'Total Interconsultas' = SUM(GBA_Rendimientos[interconsultas])
		formatString: #,##0
		displayFolder: 01. Demanda
		lineageTag: 734d184e-e3c1-47b3-8f5c-77ccb211ce7e

	measure 'Demanda Total de Atención' = [Total Consultas Médicas] + [Total Consultas Odontológicas] + [Total Consultas Paramédicas] + [Total Interconsultas]
		formatString: #,##0
		displayFolder: 01. Demanda
		lineageTag: 22c2ca2e-d393-4a11-8f86-7e3469fa9492

	measure 'Demanda Año Base (2005)' = CALCULATE([Demanda Total de Atención], GBA_Rendimientos[anio] = 2005)
		formatString: #,##0
		displayFolder: 01. Demanda
		lineageTag: d9777a38-3d43-4a5f-85c9-95795c391edc

	measure 'Demanda Año Actual (2024)' = CALCULATE([Demanda Total de Atención], GBA_Rendimientos[anio] = 2024)
		formatString: #,##0
		displayFolder: 01. Demanda
		lineageTag: 896ea13b-30e1-456d-9da5-6a59869f698b

	measure 'Crecimiento Demanda 2005-2024 %' = DIVIDE([Demanda Año Actual (2024)] - [Demanda Año Base (2005)], [Demanda Año Base (2005)])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01. Demanda
		lineageTag: e288e97d-971c-467d-8055-843404ef728b

	measure 'Crecimiento anual compuesto %' = IF([Demanda Año Base (2005)] > 0, (DIVIDE([Demanda Año Actual (2024)], [Demanda Año Base (2005)]) ^ (1/19)) - 1)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01. Demanda
		lineageTag: 9211d769-40bd-414e-ab4a-505df9e3d8c9

	measure 'Total Egresos' = SUM(GBA_Rendimientos[egresos])
		formatString: #,##0
		displayFolder: 02. Capacidad Hospitalaria
		lineageTag: 51815ce3-17d2-4b73-99b6-e5a76371203f

	measure 'Total Defunciones' = SUM(GBA_Rendimientos[defunciones])
		formatString: #,##0
		displayFolder: 03. Calidad de Internación
		lineageTag: 203ffb36-ecfb-428e-b860-45898ad7724f

	measure 'Promedio Días de Estadía' = DIVIDE(SUM(GBA_Rendimientos[dias_estadia]), [Total Egresos])
		formatString: #,##0.0
		displayFolder: 03. Calidad de Internación
		lineageTag: 4328d0b7-236e-4fdd-8acc-e6d49bb8ce03

	measure 'Tasa de Mortalidad Hospitalaria %' = DIVIDE([Total Defunciones], [Total Egresos])
		formatString: 0.00%
		displayFolder: 03. Calidad de Internación
		lineageTag: 30bcafe5-2357-403d-9225-a0816b972f57

	measure 'Crecimiento Demanda Absoluto 2005-2024' = [Demanda Año Actual (2024)] - [Demanda Año Base (2005)]
		formatString: #,##0
		displayFolder: 01. Demanda
		lineageTag: 589e706c-5373-4134-bce3-7fae1404dba9

	measure '% Ocupación Agudos 22-24' = CALCULATE(DIVIDE(SUM(GBA_Rendimientos[pacientes_dias]), SUM(GBA_Rendimientos[dias_camas_disponible])), DIM_Establecimientos[Segmento] = "Agudos", GBA_Rendimientos[anio] >= 2022 && GBA_Rendimientos[anio] <= 2024)
		formatString: 0.0%
		displayFolder: 02. Capacidad Hospitalaria
		lineageTag: 7a8e7f3e-8a9b-4cd8-923c-7eeca316e885

	measure 'Hospitales Saturados' = CALCULATE(COUNTROWS(DIM_Establecimientos), DIM_Establecimientos[Clasificacion Capacidad] = "Saturado")
		formatString: #,##0
		displayFolder: 02. Capacidad Hospitalaria
		lineageTag: 7ad8662d-03b9-4c4b-af5e-f0f014d09cd6

	measure 'Camas Subutilizadas' = CALCULATE(SUM(DIM_Establecimientos[Camas 22_24]), DIM_Establecimientos[Clasificacion Capacidad] = "Subutilizado")
		formatString: #,##0
		displayFolder: 02. Capacidad Hospitalaria
		lineageTag: 2ebd6bad-5503-4738-ba7e-ac593b587011

	measure 'Establecimientos Anomalía Ocupación' = CALCULATE(COUNTROWS(DIM_Establecimientos), DIM_Establecimientos[Clasificacion Capacidad] = "Anomalia de datos")
		formatString: #,##0
		displayFolder: 02. Capacidad Hospitalaria
		lineageTag: 2a8d7803-aa08-4175-90b7-4b3007889a63

	measure 'Ocupación Prom (estab)' = AVERAGE(DIM_Establecimientos[Ocupacion 22_24])
		formatString: 0.0%
		displayFolder: 02. Capacidad Hospitalaria
		lineageTag: c3db8edf-d6a1-4540-b1cc-9107d964efba

	measure 'Giro Prom (estab)' = AVERAGE(DIM_Establecimientos[Giro 22_24])
		formatString: #,##0.0
		displayFolder: 02. Capacidad Hospitalaria
		lineageTag: 374572a5-a4c2-4ca7-adc4-bcaa57de8f6b

	measure 'Camas 22-24 (estab)' = SUM(DIM_Establecimientos[Camas 22_24])
		formatString: #,##0
		displayFolder: 02. Capacidad Hospitalaria
		lineageTag: 575b6af9-7b1f-49d7-96de-7e988c2ac8d8

	measure 'Tasa de Mortalidad Hospitalaria 2024 %' = CALCULATE([Tasa de Mortalidad Hospitalaria %], GBA_Rendimientos[anio] = 2024)
		formatString: 0.00%
		displayFolder: 03. Calidad de Internación
		lineageTag: 826d99ae-c778-40db-bbce-a8acfda73e4a

	measure 'Promedio Días de Estadía 2024' = CALCULATE([Promedio Días de Estadía], GBA_Rendimientos[anio] = 2024)
		formatString: #,##0.0
		displayFolder: 03. Calidad de Internación
		lineageTag: 3e0254a9-52ce-4bc8-9abd-421d3f43e73c

	measure 'Establecimientos Peor Desempeño' = CALCULATE(COUNTROWS(DIM_Establecimientos), DIM_Establecimientos[Desempeno Internacion] = "Peor desempeno")
		formatString: #,##0
		displayFolder: 03. Calidad de Internación
		lineageTag: ea34c637-093d-4985-bede-eeb2c5017be3

	measure 'Estadía relativa a banda (x)' = AVERAGE(DIM_Establecimientos[LOS Ratio])
		formatString: #,##0.0
		displayFolder: 03. Calidad de Internación
		lineageTag: f5fbe027-e0ce-4b96-9b18-5f47a926f3ff

	measure 'Mortalidad relativa a banda (x)' = AVERAGE(DIM_Establecimientos[Mort Ratio])
		formatString: #,##0.0
		displayFolder: 03. Calidad de Internación
		lineageTag: f1c43665-2788-42c9-9e74-de82c3028647

	measure 'Total Defunciones 2024' = CALCULATE([Total Defunciones], GBA_Rendimientos[anio] = 2024)
		formatString: #,##0
		displayFolder: 03. Calidad de Internación
		lineageTag: 457fb981-d238-461c-a09a-a1fac4bafa49

	measure '% Participación en Crecimiento' = DIVIDE([Crecimiento Demanda Absoluto 2005-2024], CALCULATE([Crecimiento Demanda Absoluto 2005-2024], ALL(DIM_Geografia)))
		formatString: 0.0%
		displayFolder: 01. Demanda
		lineageTag: 5a095d75-3f6a-460d-8b5d-02f9c9e8eeff

	measure 'Cantidad por Tipo (2005)' = VAR _tipo = SELECTEDVALUE ( DIM_TipoPrestacion[tipo_prestacion] ) RETURN CALCULATE ( SWITCH ( _tipo, "Consultas médicas", [Total Consultas Médicas], "Consultas odontológicas", [Total Consultas Odontológicas], "Consultas paramédicas", [Total Consultas Paramédicas], "Interconsultas", [Total Interconsultas] ), GBA_Rendimientos[anio] = 2005 )
		formatString: #,##0
		displayFolder: 01. Demanda
		lineageTag: 98223f98-b436-45d2-a207-c86c212d287a

	measure 'Cantidad por Tipo (2024)' = VAR _tipo = SELECTEDVALUE ( DIM_TipoPrestacion[tipo_prestacion] ) RETURN CALCULATE ( SWITCH ( _tipo, "Consultas médicas", [Total Consultas Médicas], "Consultas odontológicas", [Total Consultas Odontológicas], "Consultas paramédicas", [Total Consultas Paramédicas], "Interconsultas", [Total Interconsultas] ), GBA_Rendimientos[anio] = 2024 )
		formatString: #,##0
		displayFolder: 01. Demanda
		lineageTag: 4128db9e-5332-47fe-bc81-faa0744b5ba9

	measure 'Color Crecimiento Demanda' =
			
			VAR Valor =
			    [Crecimiento Demanda Absoluto 2005-2024]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Valor), "#838383",
			        Valor > 0, "#22A954",
			        Valor < 0, "#BE1717",
			        "#838383"
			    )
		displayFolder: 01. Demanda
		lineageTag: 9fae3de0-64b2-427b-ac43-db0ad863136d

