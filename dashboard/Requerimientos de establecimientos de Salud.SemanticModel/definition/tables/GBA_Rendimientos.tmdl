	partition GBA_Rendimientos = m
		mode: import
		source =
				let
				    Origen = Sql.Database("NEO", "GBA_Rendimientos"),
				    #"Navegación 1" = Origen{[Schema = "stg", Item = "rendimiento_2024"]}[Data],
				    fxEntero2024 = (valor as any) as nullable number => let Texto = if valor = null then null else Text.Trim(Text.From(valor, "en-US")), Numero = if Texto = null or Texto = "" then null else if Text.Contains(Texto, ",") then try Number.FromText(Texto, "es-AR") otherwise null else if Text.Contains(Texto, ".") then try Number.FromText(Texto, "en-US") * 1000 otherwise null else try Number.FromText(Texto, "en-US") otherwise null in if Numero = null then null else Int64.From(Number.Round(Numero, 0)),
				    fxDecimal2024 = (valor as any) as nullable number => let Texto = if valor = null then null else Text.Trim(Text.From(valor)), Numero = if Texto = null or Texto = "" then null else if Text.Contains(Texto, ",") then try Number.FromText(Texto, "es-AR") otherwise null else try Number.FromText(Texto, "en-US") otherwise null in Numero,
				    fxIdTexto = (valor as any) as nullable text => let Texto = if valor = null then null else Text.Trim(Text.From(valor, "en-US")) in if Texto = null or Texto = "" then null else if Text.EndsWith(Texto, ".0") then Text.BeforeDelimiter(Texto, ".") else Texto,
				    fxMunicipioId = (valor as any) as nullable text => let Texto = fxIdTexto(valor), Numeros = if Texto = null then null else Text.Select(Texto, {"0".."9"}), Largo = if Numeros = null then 0 else Text.Length(Numeros) in if Numeros = null or Numeros = "" then null else if Largo = 6 then Numeros else if Largo = 5 then Text.Start(Numeros, 2) & "0" & Text.End(Numeros, 3) else if Largo = 4 then "0" & Text.Start(Numeros, 1) & "0" & Text.End(Numeros, 3) else Numeros,
				    #"Números 2024 corregidos" = Table.TransformColumns(#"Navegación 1", {{"consultas_odontologicas", fxEntero2024}, {"consultas_medicas", fxEntero2024}, {"consultas_paramedicas", fxEntero2024}, {"interconsultas", fxEntero2024}, {"egresos", fxEntero2024}, {"dias_camas_disponible", fxEntero2024}, {"promedio_camas_disponibles", fxEntero2024}, {"pacientes_dias", fxEntero2024}, {"promedio_dias_estadia", fxEntero2024}, {"giro_de_camas", fxEntero2024}, {"porcentaje_ocupacion", fxDecimal2024}, {"dias_estadia", fxDecimal2024}, {"defunciones", fxDecimal2024}, {"tasa_mortalidad_hospitalaria", fxDecimal2024}}),
				    #"Columnas temporales" = Table.RenameColumns(#"Números 2024 corregidos", {{"dias_estadia", "_giro_de_camas"}, {"promedio_dias_estadia", "_dias_estadia"}, {"defunciones", "_promedio_dias_estadia"}, {"giro_de_camas", "_defunciones"}}),
				    #"Columnas 2024 corregidas" = Table.RenameColumns(#"Columnas temporales", {{"_dias_estadia", "dias_estadia"}, {"_promedio_dias_estadia", "promedio_dias_estadia"}, {"_defunciones", "defunciones"}, {"_giro_de_camas", "giro_de_camas"}}),
				    #"Consulta anexada" = Table.Combine({#"Columnas 2024 corregidas", #"stg rendimiento_2005_2023"}),
				    #"Columna 0 eliminada" = Table.RemoveColumns(#"Consulta anexada", List.Intersect({Table.ColumnNames(#"Consulta anexada"), {"0"}})),
				    #"Textos limpios" = Table.TransformColumns(#"Columna 0 eliminada", {{"dependencia", each if _ = null then null else Text.Trim(Text.Clean(Text.From(_))), type nullable text}, {"region_sanitaria", each if _ = null then null else Text.Trim(Text.Clean(Text.From(_))), type nullable text}, {"municipio_nombre", each if _ = null then null else Text.Trim(Text.Clean(Text.From(_))), type nullable text}, {"establecimiento_nombre", each if _ = null then null else Text.Trim(Text.Clean(Text.From(_))), type nullable text}}),
				    #"IDs normalizados" = Table.TransformColumns(#"Textos limpios", {{"municipio_id", fxMunicipioId, type nullable text}, {"establecimiento_id", fxIdTexto, type nullable text}}),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"IDs normalizados", {{"anio", Int64.Type}, {"dependencia", type text}, {"establecimiento_id", type text}, {"region_sanitaria", type text}, {"municipio_id", type text}, {"municipio_nombre", type text}, {"establecimiento_nombre", type text}, {"consultas_odontologicas", Int64.Type}, {"consultas_medicas", Int64.Type}, {"consultas_paramedicas", Int64.Type}, {"interconsultas", Int64.Type}, {"egresos", Int64.Type}, {"dias_camas_disponible", Int64.Type}, {"promedio_camas_disponibles", Int64.Type}, {"pacientes_dias", Int64.Type}, {"porcentaje_ocupacion", type number}, {"dias_estadia", Int64.Type}, {"promedio_dias_estadia", type number}, {"defunciones", Int64.Type}, {"giro_de_camas", type number}, {"tasa_mortalidad_hospitalaria", type number}}),
				    #"Fecha agregada" = Table.AddColumn(#"Tipo cambiado", "Fecha", each #date([anio], 1, 1), type date),
				    #"Columns removed by Measure Killer"= Table.SelectColumns(#"Fecha agregada",{"promedio_camas_disponibles","region_sanitaria","pacientes_dias","establecimiento_nombre","anio","consultas_paramedicas","municipio_id","dias_camas_disponible","defunciones","interconsultas","dias_estadia","dependencia","egresos","consultas_medicas","municipio_nombre","establecimiento_id","consultas_odontologicas","Fecha"})
				in
				    #"Columns removed by Measure Killer"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

